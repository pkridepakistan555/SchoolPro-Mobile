rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function userData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isApprovedRole(role) {
      return signedIn() && userData(request.auth.uid).role == role
        && userData(request.auth.uid).approvalStatus == 'approved';
    }
    function isStaff() { return isAdmin() || isApprovedRole('teacher'); }
    function validString(value, max) { return value is string && value.size() <= max; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email','name','phone','requestedRole','role','approvalStatus','photoUrl','createdAt'])
        && request.resource.data.keys().hasOnly([
          'email','name','phone','guardianName','address','educationOrClass',
          'requestedRole','role','approvalStatus','photoUrl','documentUrls','createdAt','profileComplete'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'pending'
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.requestedRole in ['student','teacher','parent']
        && request.resource.data.name is string && request.resource.data.name.size() > 1
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7
        && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() > 0
        && (!('documentUrls' in request.resource.data) || request.resource.data.documentUrls is list && request.resource.data.documentUrls.size() <= 8)
        && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role','approvalStatus','approvedAt','approvedBy','schoolId',
            'studentId','teacherId','className','admissionNo','cardIssuedAt','rejectionReason'
          ])
          && request.resource.data.role in ['student','teacher','parent','rejected']
          && request.resource.data.approvalStatus == (request.resource.data.role == 'rejected' ? 'rejected' : 'approved')
          && request.resource.data.approvedAt == request.time
          && request.resource.data.approvedBy == request.auth.uid
          && (request.resource.data.role == 'rejected' || request.resource.data.role == 'parent'
              || (request.resource.data.schoolId is string && request.resource.data.schoolId.size() > 0)))
        || (signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.approvalStatus == resource.data.approvalStatus
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','phone','guardianName','address','educationOrClass','photoUrl','updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /systemCounters/{counterId} {
      allow read, write: if isAdmin();
    }

    // ID registry prevents two new approvals from claiming the same identifier.
    match /idRegistry/{identifier} {
      allow read, write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['name','studentId','admissionNo','className','guardianPhone','createdAt','createdBy'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.studentId is string && request.resource.data.studentId.size() > 0
        && request.resource.data.admissionNo is string && request.resource.data.admissionNo.size() > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      function validAttendance() {
        return request.resource.data.keys().hasAll(['studentId','studentName','admissionNo','className','date','status','markedBy'])
          && request.resource.data.studentId is string
          && request.resource.data.status in ['Present','Absent','Leave']
          && request.resource.data.markedBy == request.auth.uid
          && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId));
      }
      allow read: if isAdmin() || isStaff() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isStaff() && validAttendance() && request.resource.data.createdAt == request.time;
      allow update: if isStaff() && validAttendance()
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == resource.data.userId);
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if signedIn() && userData(request.auth.uid).approvalStatus == 'approved';
      allow create: if isAdmin() || isStaff();
      allow update, delete: if isAdmin();
    }
    match /classes/{docId} {
      allow read: if signedIn() && userData(request.auth.uid).approvalStatus == 'approved';
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }
    match /homework/{docId} {
      allow read: if signedIn() && userData(request.auth.uid).approvalStatus == 'approved';
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin() || (isStaff() && resource.data.createdBy == request.auth.uid);
    }
    match /exams/{docId} {
      allow read: if signedIn() && userData(request.auth.uid).approvalStatus == 'approved';
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }
    match /fees/{docId} {
      allow read: if isAdmin() || isStaff() || (signedIn() && (resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid));
      allow create, update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
