rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function validUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|application/pdf)');
    }
    match /userDocuments/{uid}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if (isAdmin() || (signedIn() && request.auth.uid == uid)) && validUpload();
      allow delete: if isAdmin();
    }
    match /userProfiles/{uid}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if (isAdmin() || (signedIn() && request.auth.uid == uid))
        && request.resource != null && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
    match /schoolCirculars/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin() && validUpload();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
